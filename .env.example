# Copy to .env and fill in your xAI API key to run live invoices.
# `make demo` and every other Makefile target work with no key at all
# (replay against committed cassettes) — you only need this to process
# an invoice the system has never seen.

XAI_API_KEY=

# Model. Defaults to grok-4.5 (what cassettes were recorded against).
# Only change this if you know what you're doing; a different model
# invalidates every cassette on disk.
GROK_MODEL=grok-4.5

# One of: replay | live | auto.
# Reviewer default is `replay` — never spends. CLI flags (--live / --replay
# / --auto in main.py) override this at run time, so you rarely need to
# set it here.
LLM_MODE=replay
